# Spotify Playlist Manager — environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Spotify App credentials ────────────────────────────────────────────────────
# Your Spotify application's Client ID (from https://developer.spotify.com/dashboard)
VITE_SPOTIFY_CLIENT_ID=your_client_id_here # HashiCorpIgnore

# Redirect URI registered in your Spotify app dashboard.
# Use http://127.0.0.1:5173/callback for local Vite dev.
# Must be HTTPS in production.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Space-separated list of OAuth scopes required by this application.
# Only the minimum necessary scopes are listed here.
VITE_SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private
